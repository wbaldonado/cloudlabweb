# CloudLab Latam — production .env for Hostinger
# Copy to .env on the server (hPanel File Manager or SFTP). Never commit .env.

APP_NAME="CloudLab Latam"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cloudlablatam.tech

LOG_CHANNEL=stack
LOG_LEVEL=error

# Hostinger MySQL: create DB in hPanel → Databases → MySQL
# DB_HOST is almost always localhost on shared hosting
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_cloudlab
DB_USERNAME=u123456789_cloudlab
DB_PASSWORD=your_db_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=*

# CSP: set REPORT_ONLY=true first, then false when site works
CSP_ENABLED=true
CSP_REPORT_ONLY=false

# Hostinger email (hPanel → Emails → your mailbox → SMTP settings)
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=info@cloudlablatam.com
MAIL_PASSWORD=your_mailbox_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@cloudlablatam.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional: one-time token for deploy/run-artisan.php (delete file after use)
# DEPLOY_RUN_TOKEN=change-to-long-random-string
