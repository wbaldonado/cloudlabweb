# CloudLab Latam — production .env for Hostinger
# Copy to .env on the server (hPanel File Manager or SFTP). Never commit .env.

APP_NAME="CloudLab Latam"
APP_ENV=production
# REQUIRED — leave empty only until you run: php artisan key:generate --force
APP_KEY=
APP_DEBUG=false
APP_URL=https://cloudlablatam.tech

# Logo — file must exist at: laravel_app/public/images/logo-brand.png
# Test in browser: https://yourdomain.com/images/logo-brand.png
# If that URL 404s but https://yourdomain.com/public/images/logo-brand.png works,
# your document root is laravel_app (not public). Either:
#   A) Set document root to .../laravel_app/public in hPanel (best), OR
#   B) Upload the root .htaccess file (rewrites to public/), OR
#   C) Uncomment ASSET_PREFIX below
# ASSET_PREFIX=public
# Optional absolute override if needed:
# LOGO_URL=https://cloudlablatam.tech/images/logo-brand.png
# LOGO_PATH=images/logo-brand.png

LOG_CHANNEL=stack
LOG_LEVEL=error

# Hostinger MySQL: create DB in hPanel → Databases → MySQL
# DB_HOST is almost always localhost on shared hosting
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_cloudlab
DB_USERNAME=u123456789_cloudlab
DB_PASSWORD=your_db_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Set false if APP_KEY is not set yet (otherwise login returns HTTP 500)
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=*

# CSP: set REPORT_ONLY=true first, then false when site works
CSP_ENABLED=true
CSP_REPORT_ONLY=false

# Hostinger email (hPanel → Emails → your mailbox → SMTP settings)
# If password has [ ] # ! $ " or spaces, keep the double quotes.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=info@cloudlablatam.com
MAIL_PASSWORD="your_mailbox_password"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@cloudlablatam.com"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_TO_EMAIL=info@cloudlablatam.com

# CRM email (free — Hostinger SMTP send + IMAP reply polling)
CRM_MESSAGE_ID_DOMAIN=cloudlablatam.tech
CRM_NOTIFY_EMAIL=info@cloudlablatam.com
CRM_IMAP_ENABLED=true
CRM_IMAP_HOST=imap.hostinger.com
CRM_IMAP_PORT=993
CRM_IMAP_ENCRYPTION=ssl
CRM_IMAP_USERNAME=info@cloudlablatam.com
CRM_IMAP_PASSWORD="your_mailbox_password"
CRM_IMAP_FOLDER=INBOX

# Flask CRM (optional — Python app sharing this database)
# When set, admin sidebar "CRM Dashboard" opens this URL instead of Laravel CRM.
# Example subdomain: https://crm.cloudlablatam.tech/admin/crm
# CRM_FLASK_URL=https://crm.cloudlablatam.tech/admin/crm

# WhatsApp Lead Agent (Meta Cloud API)
# Requires WhatsApp Business API number + webhook:
#   https://your-domain.com/webhooks/whatsapp
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=cloudlab-whatsapp-verify-change-me
WHATSAPP_NUMBER=573208156396
WHATSAPP_PREFILL_TEXT="Hola, quiero información"
WHATSAPP_NOTIFY_EMAIL=info@cloudlablatam.com
WHATSAPP_API_VERSION=v21.0

# Cron (hPanel → Advanced → Cron Jobs): every 10 minutes
# */10 * * * * cd /home/USER/domains/cloudlablatam.tech/laravel_app && php artisan crm:fetch-inbox >> /dev/null 2>&1
# Or every minute for Laravel scheduler:
# * * * * * cd /home/USER/domains/cloudlablatam.tech/laravel_app && php artisan schedule:run >> /dev/null 2>&1

# Optional: one-time token for deploy/run-artisan.php (delete file after use)
# DEPLOY_RUN_TOKEN=change-to-long-random-string
