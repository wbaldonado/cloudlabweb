# Flask CRM — shares MySQL with Laravel CloudLab Latam
FLASK_ENV=development
SECRET_KEY=change-me-to-random-string
CRM_BASE_URL=http://127.0.0.1:5001

# Same database as Laravel .env
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_cloudlab
DB_USERNAME=root
DB_PASSWORD=

# SMTP (Hostinger — same as Laravel MAIL_*)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=info@cloudlablatam.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@cloudlablatam.com
MAIL_FROM_NAME=CloudLab Latam

# IMAP reply polling (free)
CRM_IMAP_ENABLED=false
CRM_IMAP_HOST=imap.hostinger.com
CRM_IMAP_PORT=993
CRM_IMAP_USERNAME=info@cloudlablatam.com
CRM_IMAP_PASSWORD=
CRM_NOTIFY_EMAIL=admin@cloudlablatam.com
CRM_MESSAGE_ID_DOMAIN=cloudlablatam.tech

# Link back to main Laravel admin
LARAVEL_ADMIN_URL=http://localhost/cloudlablatam1/public/admin
